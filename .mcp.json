{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"],
      "tools": ["resolve-library-id", "query-docs"]
    },
    "obsidian-memory": {
      "type": "stdio",
      "command": "npm",
      "args": ["--silent", "--prefix", "tools/obsidian-memory-mcp", "run", "start"],
      "tools": ["search_memory", "read_memory_note"]
    }
  }
}
