# =============================================================================
# Frontend — variáveis de desenvolvimento
# =============================================================================
# Copie para .env.local:
#   cp .env.local.example .env.local
#
# IMPORTANTE (loop de carregamento / preview remoto):
#   Em dev, NEXT_PUBLIC_API_URL DEVE ser "/backend" (proxy same-origin do Next).
#   NÃO use http://localhost:3000 — no port-forward/Cloud Agent preview o browser
#   do usuário não alcança 127.0.0.1:3000 e a UI fica em spinner eterno.
#   O rewrite em next.config.mjs encaminha /backend/* → BACKEND_INTERNAL_URL.
# =============================================================================

NEXT_PUBLIC_API_URL=/backend
BACKEND_INTERNAL_URL=http://127.0.0.1:3000
NEXT_PUBLIC_APP_URL=http://localhost:3001
