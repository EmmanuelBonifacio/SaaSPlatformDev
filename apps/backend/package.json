{
  "name": "saas-platform-dev-backend",
  "version": "1.0.0",
  "description": "Sistema SaaS Multitenant com isolamento por Schema no PostgreSQL",
  "author": "Seu Nome",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:seed:modules": "tsx --env-file=.env src/seeds/modules.seed.ts",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:migrate:auth": "tsx prisma/migrate-add-auth-tables.ts",
    "db:migrate:tv-plan": "tsx prisma/migrate-tenant-tv-plan.ts",
    "db:migrate:xibo-ads": "tsx prisma/migrate-xibo-platform-ads.ts",
    "db:migrate:paperclip": "tsx --env-file=.env prisma/migrate-paperclip-tenant-tables.ts",
    "db:migrate:memory": "tsx --env-file=.env prisma/migrate-memory-tenant-tables.ts",
    "db:admin:update": "tsx prisma/update-admin-credentials.ts",
    "db:seed:user": "tsx prisma/seed-user.ts",
    "db:seed:demo-stores": "tsx prisma/seed-demo-stores.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@saasplatform/paperclip-agent-sdk": "file:../../packages/paperclip-agent-sdk",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^5.6.0",
    "@fastify/static": "^9.0.0",
    "@prisma/client": "^6.0.0",
    "@types/qrcode": "^1.5.6",
    "bcrypt": "^6.0.0",
    "expo-server-sdk": "^3.15.0",
    "fastify": "^5.0.0",
    "node-cron": "^3.0.3",
    "redis": "^5.0.0",
    "node-ssdp": "^4.0.1",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.3",
    "tsx": "^4.19.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/node-ssdp": "^4.0.5",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "ip": "^2.0.1"
  }
}
