# Copie: cp .env.example .env
# NUNCA commite o .env real. Gere os secrets localmente.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Postgres do docker-compose (porta host 5433)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/saas_dev

# Gere com: openssl rand -hex 64  (mínimo 64 chars)
JWT_SECRET=SUBSTITUA_POR_OPENSSL_RAND_HEX_64_CHARS_MINIMO________________
JWT_REFRESH_SECRET=SUBSTITUA_POR_OUTRO_OPENSSL_RAND_HEX_64_CHARS_MINIMO_
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
REDIS_CENTRAL_URL=redis://localhost:6379
BCRYPT_ROUNDS=12
UPLOADS_DIR=./uploads

# Opcional em dev
EVOLUTION_API_HOST=http://localhost:8080
EVOLUTION_API_KEY=saas_evolution_secret
