{
  "name": "@saasplatform/agents-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Cliente HTTP tipado para a API nativa /agents do SaaS (não Paperclip).",
  "type": "module",
  "main": "./dist/index.js",
